{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Widespread Wallet",
  "version": "0.1.0",
  "identifier": "fyi.widespread.wallet",
  "build": {
    "frontendDist": "../../web/wallet/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Widespread Wallet",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://testnet.lez.logos.co https://api.codex.storage; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": [],
    "externalBin": ["binaries/wsp-lezd"]
  }
}
